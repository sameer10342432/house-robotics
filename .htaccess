# =====================================================================
# HOUSE ROBOTICS — Production Apache .htaccess Configuration
# Full-Service Digital Marketing & Technology Agency
# Compatible with cPanel Shared Hosting & Apache 2.4+
# =====================================================================

# 1. Security Options & Disable Directory Listing
Options -Indexes -MultiViews
ServerSignature Off

# 2. Block Access to Sensitive Files and Directories
<FilesMatch "(?i)(\.env|\.git|\.yml|\.yaml|\.lock|package\.json|tsconfig\.json|vite\.config\.ts|database\.sql|\.sqlite|\.log|\.md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct web access to sensitive internal backend folders
    RewriteRule ^(config|includes|database|node_modules|server|src|scratch)(/.*)?$ - [F,L,NC]

    # Force HTTPS redirection (standard cPanel SSL)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. Dynamic XML Sitemap and Robots.txt
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
    RewriteRule ^robots\.txt$ robots.php [L,QSA]

    # 4. PHP REST API Routing
    # Ensure /api/ requests are routed to api/index.php and NEVER to index.html
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ api/index.php [L,QSA]

    # If direct request to /api or /api/
    RewriteRule ^api/?$ api/index.php [L,QSA]

    # 5. Static Assets and Existing Files/Directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. React Single Page Application (SPA) Catch-All
    # Send all other frontend routes (/about, /services, /admin, etc.) to index.html
    RewriteRule ^ index.html [L]
</IfModule>

# 7. Browser Caching for Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 8. Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
