# ==============================================================
# HOUSE ROBOTICS — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# Rename this file to .env on your server before starting the app.
# ==============================================================

# Node Environment & Port
NODE_ENV=production
PORT=5000

# Application URLs
APP_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com
VITE_API_URL=https://your-domain.com

# --------------------------------------------------------------
# DATABASE CONNECTION
# --------------------------------------------------------------
# Option A (Recommended for zero-config cPanel / local Node deployment):
DATABASE_URL="file:./dev.db"

# Option B (PostgreSQL on cPanel / Cloud):
# DATABASE_URL="postgresql://cpaneluser_dbuser:StrongPassword123@localhost:5432/cpaneluser_houserobotics?schema=public"

# Option C (MySQL / MariaDB on cPanel):
# DATABASE_URL="mysql://cpaneluser_dbuser:StrongPassword123@localhost:3306/cpaneluser_houserobotics"

# --------------------------------------------------------------
# AUTHENTICATION & SECURITY TOKENS
# --------------------------------------------------------------
JWT_SECRET=replace_with_random_32_character_secret_key_for_jwt_tokens
SESSION_SECRET=replace_with_random_32_character_secret_key_for_sessions

# --------------------------------------------------------------
# EMAIL DELIVERY CONFIGURATION (SMTP)
# --------------------------------------------------------------
# Works with cPanel Webmail, Gmail, Amazon SES, SendGrid, etc.
SMTP_HOST=mail.your-domain.com
SMTP_PORT=465
SMTP_USER=notifications@your-domain.com
SMTP_PASSWORD=your_email_password_here
EMAIL_FROM="House Robotics Notifications <notifications@your-domain.com>"
ADMIN_EMAIL=sameerliaqat81@gmail.com

# --------------------------------------------------------------
# MEDIA UPLOADS & FILE STORAGE
# --------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=public/uploads

# --------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# --------------------------------------------------------------
GA_MEASUREMENT_ID=
GEMINI_API_KEY=
